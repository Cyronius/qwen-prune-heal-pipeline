{"id": "simple-01", "category": "simple", "tools": ["get_weather"], "messages": [{"role": "user", "content": "What's the weather in Tokyo right now?"}], "expect": {"call": true, "name": "get_weather", "args": {"city": {"eq": ["Tokyo", "Tokyo, Japan"]}}, "args_optional": ["units"]}}
