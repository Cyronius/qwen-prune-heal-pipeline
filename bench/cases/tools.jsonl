{"id": "multiturn-01", "category": "multiturn", "tools": ["get_weather"], "messages": [{"role": "user", "content": "What's the weather in Tokyo?"}, {"role": "assistant", "tool_calls": [{"id": "call_1", "type": "function", "function": {"name": "get_weather", "arguments": "{\"city\": \"Tokyo\"}"}}]}, {"role": "tool", "tool_call_id": "call_1", "content": "{\"temp_c\": 31, \"condition\": \"sunny\", \"humidity\": 60}"}], "expect": {"call": false, "content_contains": ["31"]}}
{"id": "multiturn-02", "category": "multiturn", "tools": ["get_forecast"], "messages": [{"role": "user", "content": "Any rain coming in Portland this week?"}, {"role": "assistant", "tool_calls": [{"id": "call_1", "type": "function", "function": {"name": "get_forecast", "arguments": "{\"city\": \"Portland\", \"days\": 7}"}}]}, {"role": "tool", "tool_call_id": "call_1", "content": "{\"days\": [{\"day\": \"Wednesday\", \"condition\": \"cloudy\"}, {\"day\": \"Thursday\", \"condition\": \"heavy rain\"}, {\"day\": \"Friday\", \"condition\": \"clear\"}]}"}], "expect": {"call": false, "content_contains": ["Thursday"]}}
{"id": "multiturn-03", "category": "multiturn", "tools": ["read_file"], "messages": [{"role": "user", "content": "What version is set in C:\\app\\config.ini?"}, {"role": "assistant", "tool_calls": [{"id": "call_1", "type": "function", "function": {"name": "read_file", "arguments": "{\"path\": \"C:\\\\app\\\\config.ini\"}"}}]}, {"role": "tool", "tool_call_id": "call_1", "content": "[app]\nname=orchestrator\nversion=2.4.1\nport=8080"}], "expect": {"call": false, "content_contains": ["2.4.1"]}}
{"id": "multiturn-04", "category": "multiturn", "tools": ["search_web"], "messages": [{"role": "user", "content": "When was the RX 9070 released?"}, {"role": "assistant", "tool_calls": [{"id": "call_1", "type": "function", "function": {"name": "search_web", "arguments": "{\"query\": \"RX 9070 release date\"}"}}]}, {"role": "tool", "tool_call_id": "call_1", "content": "Top result: The AMD Radeon RX 9070 was released in March 2026."}], "expect": {"call": false, "content_contains": ["March", "2026"]}}
{"id": "multiturn-05", "category": "multiturn", "tools": ["get_weather"], "messages": [{"role": "user", "content": "What's it like outside in Boston?"}, {"role": "assistant", "tool_calls": [{"id": "call_1", "type": "function", "function": {"name": "get_weather", "arguments": "{\"city\": \"Boston\"}"}}]}, {"role": "tool", "tool_call_id": "call_1", "content": "{\"temp_c\": 12, \"condition\": \"windy\"}"}, {"role": "assistant", "content": "It's currently 12\u00b0C and windy in Boston."}, {"role": "user", "content": "Should I bring a jacket?"}], "expect": {"call": false, "content_contains": ["jacket", "yes", "cool", "cold", "12"]}}
{"id": "multiturn-06", "category": "multiturn", "tools": ["get_weather"], "messages": [{"role": "user", "content": "Weather in Reykjavik please."}, {"role": "assistant", "tool_calls": [{"id": "call_1", "type": "function", "function": {"name": "get_weather", "arguments": "{\"city\": \"Reykjavik\"}"}}]}, {"role": "tool", "tool_call_id": "call_1", "content": "{\"error\": \"weather service temporarily unavailable\"}"}], "expect": {"call": false, "content_contains": ["unavailable", "try again", "later", "unable", "sorry", "couldn't", "could not"]}}
